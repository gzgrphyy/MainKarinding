  m_Name: Ch1_S5_Intro
  m_EditorClassIdentifier: Assembly-CSharp:Karinding.Dialogue:DialogueSequence
  sequenceId: ch1_s5_intro
  lines:
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Rimba, hayu urang milarian awi ka leuweung. Karinding Rimba kudu di jieun
      ku panangan Rimba sorangan.
    translation: Rimba, ayo kita nyari bambu di hutan. Karinding Rimba harus dibuat
      sama tangan Rimba sendiri
    eventId: 
    choices: []
  - speakerName: Rimba
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 0
    text: Kumaha cara milih awi nu sae, Bah?
    translation: Gimana cara milih bambu yang bagus, Bah?
    eventId: 
    choices: []
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Awi nu sae teh nu tos cekap umur na. teu ngora teuing, teu kolot teuing.
      Batang na ge kudu seseug, ulah nu ipis
    translation: Bambu yang bagus itu yang sudah cukup umur. Ngga terlalu muda, ngga
      terlalu tua. Batangnya juga harus padat, jangan kopong
    eventId: 
    choices: []
