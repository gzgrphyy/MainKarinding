  m_Name: Ch1_S8_Perpisahan
  m_EditorClassIdentifier: Assembly-CSharp:Karinding.Dialogue:DialogueSequence
  sequenceId: ch1_s8_perpisahan
  lines:
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Rimba... Karinding ieu ulah ngan saukur jang Rimba nyalira. Abah hoyong
      nu sanes ge terang kana alat bebunyian ieu.
    translation: Rimba... Karinding ini jangan cuma buat kamu sendiri. Abah ingin
      orang lain juga tau sama alat bebunyian ini.
    eventId: 
    choices: []
  - speakerName: Rimba
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 0
    text: Maksudna kumaha, Bah?
    translation: Maksudnya gimana, Bah?
    eventId: 
    choices: []
  - speakerName: Rimba
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 0
    text: Abah, bade kamana?
    translation: Abah mau kemana?
    eventId: ABAH_IKAT_BEDOG
    choices: []
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: "N\xE9angan nu eweuh."
    translation: Mencari sesuatu yang tidak ada.
    eventId: 
    choices: []
  - speakerName: Rimba
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 0
    text: Dimana bah nu eweuh teh ?
    translation: Dimana bah yang gaada itu?
    eventId: 
    choices: []
