MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 0}
  m_Name: Ch1_S1_Teras
  m_EditorClassIdentifier: Assembly-CSharp:Karinding.Dialogue:DialogueSequence
  sequenceId: ch1_s1_teras
  lines:
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Baba tos gugah gening ? Sok gera wawasuh heula
    translation: Baba udah bangun ternyata? Sana cuci muka dulu
    eventId: 
    choices: []
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Aya jalan nu kudu dilakonan ku nyalira, Ba. Abah keur ngora ge kitu
    translation: Ada jalan yang harus ditempuh sendiri, Ba. Ketika Abah muda juga
      begitu
    eventId: 
    choices: []
  - speakerName: Rimba
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 0
    text: Maksudna kumaha bah ?
    translation: Maksudnya gimana bah?
    eventId: 
    choices: []
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Moal karasa ayeuna. Engke ge ngarti sorangan
    translation: Ga bakal kerasa sekarang. Nanti juga ngerti sendiri.
    eventId: 
    choices: []
  - speakerName: Abah
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 1
    text: Tos tong di pikiran teuing. Ayeuna mah urang ka kebon we hayu, bisi kaburu
      panas
    translation: Udah jangan terlalu dipikirin. Sekarang kita ke kebun aja, takutnya
      keburu panas
    eventId: 
    choices: []
  - speakerName: Rimba
    isNarration: 0
    portrait: {fileID: 0}
    portraitSide: 0
    text: Muhun bah, Hayu
    translation: Iya bah, ayo
    eventId: 
    choices: []
